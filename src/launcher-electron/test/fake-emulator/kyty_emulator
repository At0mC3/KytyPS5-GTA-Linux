#!/usr/bin/env node
// Stand-in for kyty_emulator in launcher tests: answers --query like the real emulator and
// records the arguments of game launches.
'use strict';
const fs = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
const env = process.env;

function readStdin() {
	try {
		return fs.readFileSync(0, 'utf8');
	} catch {
		return '';
	}
}

function result(value) {
	process.stdout.write(`KYTY_QUERY_RESULT ${JSON.stringify(value)}\n`);
}

function copyIcon(target) {
	if (env.KYTY_FAKE_ICON && fs.existsSync(env.KYTY_FAKE_ICON)) {
		fs.mkdirSync(path.dirname(target), { recursive: true });
		fs.copyFileSync(env.KYTY_FAKE_ICON, target);
		return target;
	}
	return null;
}

if (args.length === 0) {
	process.stdout.write('Release, clang-lld, ver = 0.3.0, git = fake, date = 2026-10-09\nkyty_emulator --game <dir|elf|zar> [options]\n');
	process.exit(0);
}

if (args[0] === '--query') {
	const command = args[1];
	if (command === 'info') {
		result({
			version: '0.3.0',
			gitVersion: 'fake',
			gitHash: 'fake',
			buildLabel: 'Fork build fake/KytyPS5 fake',
			origin: 'Fork',
			releaseTag: '',
			repository: 'fake/KytyPS5',
			updateCheckSupported: false,
			gpus: [
				{ index: 0, name: 'Fake Radeon RX 7900', type: 'discrete', apiVersion: 4206592, vendorID: 4098, deviceID: 1, driverVersion: 1, meetsRequirements: true },
				{ index: 1, name: 'Fake Integrated GPU', type: 'integrated', apiVersion: 4202496, vendorID: 32902, deviceID: 2, driverVersion: 1, meetsRequirements: false },
			],
			microphones: ['Fake USB Microphone'],
		});
		process.exit(0);
	}
	if (command === 'archives') {
		const request = JSON.parse(readStdin());
		const archives = request.archives.map((archive, index) => {
			const dir = path.join(request.outDir, String(index), 'sce_sys');
			fs.mkdirSync(dir, { recursive: true });
			const base = path.basename(archive, path.extname(archive));
			const param = path.join(dir, 'param.json');
			fs.writeFileSync(param, JSON.stringify({ titleId: 'PPSA09999', appVersion: '01.002.000', localizedParameters: { defaultLanguage: 'en-US', 'en-US': { titleName: `${base} (archive)` } } }));
			return { path: archive, ok: true, hasEboot: true, files: { 'sce_sys/param.json': param, 'sce_sys/icon0.png': copyIcon(path.join(dir, 'icon0.png')), 'sce_sys/pic0.png': null }, trophyFiles: [] };
		});
		result({ archives });
		process.exit(0);
	}
	if (command === 'trophies') {
		const request = JSON.parse(readStdin());
		const games = request.games.map((game) => {
			const names = ['Welcome to Los Santos', 'A Friendship Resurrected', 'Hidden Gems', 'Career Criminal', 'Solid Gold, Baby!', 'Kifflom!'];
			const trophies = names.map((name, id) => ({
				id,
				groupId: -1,
				platinumId: -1,
				grade: id === 0 ? 1 : id < 2 ? 2 : id < 4 ? 3 : 4,
				hidden: id === 5,
				hasReward: false,
				name,
				description: `Fixture trophy ${id}.`,
				reward: '',
				icon: request.iconDir ? copyIcon(path.join(request.iconDir, game.key, `trophy${id}.png`)) : null,
				unlocked: id % 2 === 1,
				unlockedAtMs: id % 2 === 1 ? 1767225600000 + id * 3600000 : null,
			}));
			const summary = { total: 6, earned: 3, percentage: 42, totalGrade: [0, 1, 1, 2, 2], earnedGrade: [0, 0, 1, 1, 1] };
			if (game.titleId !== 'PPSA04263') {
				return { key: game.key, packages: [], errors: [], summary: { total: 0, earned: 0, percentage: 0, totalGrade: [0, 0, 0, 0, 0], earnedGrade: [0, 0, 0, 0, 0] } };
			}
			return { key: game.key, packages: [{ file: 'trophy00.ucp', serviceLabel: 0, title: 'Grand Theft Auto V', groups: [], progress: summary, trophies: request.iconDir === null ? [] : trophies }], errors: [], summary };
		});
		result({ games });
		process.exit(0);
	}
	if (command === 'controller') {
		const log = env.KYTY_FAKE_CTRL_LOG;
		process.stdin.setEncoding('utf8');
		process.stdin.on('data', (chunk) => {
			if (log) fs.appendFileSync(log, chunk);
		});
		process.stdin.on('end', () => process.exit(0));
		return;
	}
	process.stderr.write(`Unknown query: ${command}\n`);
	process.exit(2);
}

// A game launch.
if (env.KYTY_FAKE_ARGV) {
	fs.appendFileSync(env.KYTY_FAKE_ARGV, `${JSON.stringify(args)}\n`);
}
const red = '\x1b[31m';
const green = '\x1b[32m';
const reset = '\x1b[0m';
process.stdout.write(`${green}Kyty fake emulator starting${reset}\n`);
process.stdout.write(`Game: ${args[args.indexOf('--game') + 1]}\n`);
process.stderr.write(`${red}warning: this is a fake emulator${reset}\n`);
let frame = 0;
const timer = setInterval(() => process.stdout.write(`frame ${++frame}\n`), 200);
const finish = (code) => {
	clearInterval(timer);
	process.stdout.write('Exiting\n');
	process.exit(code);
};
process.on('SIGTERM', () => finish(0));
setTimeout(() => finish(Number(env.KYTY_FAKE_EXIT_CODE ?? 0)), Number(env.KYTY_FAKE_RUN_MS ?? 60000));
