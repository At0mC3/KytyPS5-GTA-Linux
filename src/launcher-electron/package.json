{
  "name": "kyty-launcher",
  "productName": "KytyPS5 Launcher",
  "version": "1.0.0",
  "description": "Controller-friendly launcher for the KytyPS5 emulator",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --dir",
    "install-to": "node scripts/copy-to-install.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "author": "KytyPS5 contributors",
  "homepage": "https://github.com/At0mC3/KytyPS5-GTA-Linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/At0mC3/KytyPS5-GTA-Linux.git"
  }
}
